# ─────────────────────────────────────────────────────────
# DATABASE (Supabase PostgreSQL)
# ─────────────────────────────────────────────────────────
#
# WHERE TO FIND THIS:
#   Supabase Dashboard → Your Project → Settings → Database → Connection String → URI
#
# ⚠️  Do NOT use the Supabase API URL (https://xyz.supabase.co) — that is NOT this.
#
# Use ONE of these two formats:
#
# Option A — Direct connection (no pooler, best for migrations):
#   postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Option B — Pooler connection (recommended for production):
#   postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────
# GOOGLE GEMINI API KEY (for Athena AI)
# ─────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────
# App Settings
# ─────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=FinQuest
